<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:layout_marginStart="8dp"
    android:layout_marginEnd="8dp"
    android:keepScreenOn="true"
    android:fitsSystemWindows="true"
    tools:ignore="ContentDescription"
    tools:context=".MainActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/main_toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:menu="@menu/main_menu"
        app:title="@string/app_title_ofeed_connector"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <ImageView
        android:id="@+id/main_ofeed_featured_image"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:alpha="0.2"
        android:scaleType="matrix"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_status_caption"
        app:layout_constraintBottom_toBottomOf="parent" />
    <TextView
        android:id="@+id/main_event_name"
        style="@style/medium_wrap_content"
        android:layout_width="0dp"
        android:gravity="center_horizontal"
        android:textStyle="bold"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_toolbar" />
    <TextView
        android:id="@+id/main_service_status_caption"
        style="@style/medium_bold_wrap_content"
        android:textSize="24sp"
        android:text="@string/status"
        android:layout_marginTop="16dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_event_name" />

    <ImageView
        android:id="@+id/main_service_status_icon"
        android:layout_width="36dp"
        android:layout_height="36dp"
        app:srcCompat="@drawable/status_ok"
        app:layout_constraintHorizontal_chainStyle="packed"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toStartOf="@id/main_service_status"
        app:layout_constraintTop_toTopOf="@id/main_service_status"
        app:layout_constraintBottom_toBottomOf="@id/main_service_status" />
    <TextView
        android:id="@+id/main_service_status"
        style="@style/medium_wrap_content"
        android:textSize="24sp"
        android:text="@string/status_running"
        android:layout_marginTop="32dp"
        android:layout_marginStart="8dp"
        app:layout_constraintStart_toEndOf="@id/main_service_status_icon"
        app:layout_constraintEnd_toStartOf="@id/main_service_status_help"
        app:layout_constraintTop_toTopOf="@id/main_service_status_caption" />
    <ImageView
        android:id="@+id/main_service_status_help"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="8dp"
        app:srcCompat="@drawable/help"
        android:visibility="gone"
        app:layout_constraintStart_toEndOf="@id/main_service_status"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="@id/main_service_status"
        app:layout_constraintBottom_toBottomOf="@id/main_service_status" />

    <Button
        android:id="@+id/main_start_button"
        style="@style/button_style_24sp"
        android:layout_marginTop="32dp"
        android:text="@string/start_uploading"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_service_status_help" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/main_countdown_indicator"
        android:layout_width="128dp"
        android:layout_height="128dp"
        android:layout_marginTop="32dp"
        android:indeterminate="false"
        app:indicatorSize="128dp"
        app:trackThickness="16dp"
        app:trackCornerRadius="3dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_start_button" />
    <TextView
        android:id="@+id/main_countdown_text"
        style="@style/medium_bold_wrap_content"
        android:textSize="24sp"
        android:text="60"
        tools:ignore="HardcodedText"
        android:visibility="invisible"
        app:layout_constraintStart_toStartOf="@id/main_countdown_indicator"
        app:layout_constraintEnd_toEndOf="@id/main_countdown_indicator"
        app:layout_constraintTop_toTopOf="@id/main_countdown_indicator"
        app:layout_constraintBottom_toBottomOf="@id/main_countdown_indicator" />

    <ImageView
        android:id="@+id/main_countdown_ok_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:srcCompat="@drawable/status_ok"
        android:visibility="invisible"
        tools:ignore="ContentDescription"
        app:layout_constraintStart_toStartOf="@id/main_countdown_indicator"
        app:layout_constraintEnd_toEndOf="@id/main_countdown_indicator"
        app:layout_constraintTop_toTopOf="@id/main_countdown_indicator"
        app:layout_constraintBottom_toBottomOf="@id/main_countdown_indicator" />

    <ImageView
        android:id="@+id/main_countdown_error_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:srcCompat="@drawable/error_red"
        android:visibility="invisible"
        tools:ignore="ContentDescription"
        app:layout_constraintStart_toStartOf="@id/main_countdown_indicator"
        app:layout_constraintEnd_toEndOf="@id/main_countdown_indicator"
        app:layout_constraintTop_toTopOf="@id/main_countdown_indicator"
        app:layout_constraintBottom_toBottomOf="@id/main_countdown_indicator" />

    <androidx.appcompat.widget.AppCompatImageView
        android:id="@+id/main_countdown_upload_icon"
        android:layout_width="72dp"
        android:layout_height="72dp"
        app:srcCompat="@drawable/upload_animated"
        android:visibility="invisible"
        tools:ignore="ContentDescription"
        app:layout_constraintStart_toStartOf="@id/main_countdown_indicator"
        app:layout_constraintEnd_toEndOf="@id/main_countdown_indicator"
        app:layout_constraintTop_toTopOf="@id/main_countdown_indicator"
        app:layout_constraintBottom_toBottomOf="@id/main_countdown_indicator" />

    <TextView
        android:id="@+id/main_status_caption"
        style="@style/medium_bold_wrap_content"
        android:textSize="24sp"
        android:layout_marginTop="32dp"
        android:text="@string/uploads"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_countdown_indicator" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/main_status_recycler_view"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@id/main_status_caption"
        app:layout_constraintBottom_toBottomOf="parent"/>
</androidx.constraintlayout.widget.ConstraintLayout>
