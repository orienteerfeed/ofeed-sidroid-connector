    <string name="help_title">Nápověda</string>
    <string name="help_message">Aplikace získává výsledky z výsledkové služby v mobilní aplikaci
        SI-Droid Event a nahrává je na OFeed nebo OResults.
        \n\nZároveň je možné nahrát i xml výsledky z lokálního souboru.
        \n\nNahrávané výsledky je možné doplnit o unikátní identifikátor pro každého závodníka.
    </string>

