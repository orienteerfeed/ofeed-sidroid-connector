    <string name="server_help">OFeed server address (URL):
        \n■ Default <i>https://api.orienteerfeed.com/rest/v1/events</i>
        \n■ <i>api.orienteerfeed.com</i> → default
        \n■ <i>xxx.yyy.zzz</i> → <i>https://xxx.yyy.zzz/rest/v1/events</i>
        \n■ Path must be <i>/rest/v1/events</i>
        \n■ Android requires <i>https</i>
    </string>
