    <string name="help_title">Help</string>
    <string name="help_message">This app retrieves results lists from SI-Droid Event
        and uploads them to OFeed or OResults.
        \n\nIt can also upload a results list from the local storage of the device.
        \n\nThe uploaded results list can be updated with a unique id for each competitor.
    </string>

